# Inquiry emails (both "Check your date" forms) are sent through Resend: https://resend.com
# The visitor gets a branded confirmation from fun@revelrita.com, and Helen gets her own copy
# (from website@revelrita.com, reply-to the visitor). Copy this file to .env.local for local dev,
# and add the same variables in Vercel > Project > Settings > Environment Variables.

# Required. Create at https://resend.com/api-keys ("Sending access" is enough).
# revelrita.com must be verified in Resend (Domains) first, or Resend refuses to send to visitors.
RESEND_API_KEY=

# Optional. Who the visitor's confirmation is from. Defaults to "Revelrita <fun@revelrita.com>"
INQUIRY_FROM=

# Optional. Where Helen's copy goes. Defaults to fun@revelrita.com
INQUIRY_TO=

# Optional. Who Helen's copy is from. Defaults to "Revelrita website <website@revelrita.com>".
# Must not be INQUIRY_TO itself: Gmail files mail from your own address under Sent, not the inbox.
INQUIRY_NOTIFY_FROM=
