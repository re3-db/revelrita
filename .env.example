# Inquiry emails (both "Check your date" forms) are sent through Resend: https://resend.com
# Copy this file to .env.local for local dev, and add the same variables in Vercel > Project > Settings > Environment Variables.

# Required. Create at https://resend.com/api-keys
RESEND_API_KEY=

# Optional. Where inquiries go. Defaults to fun@revelrita.com
INQUIRY_TO=fun@revelrita.com

# Optional. Who the email is from. Defaults to "Revelrita website <onboarding@resend.dev>",
# which Resend only allows when INQUIRY_TO is the email the Resend account was created with.
# Once revelrita.com is verified in Resend (Domains), switch to e.g.:
# INQUIRY_FROM=Revelrita website <website@revelrita.com>
INQUIRY_FROM=
